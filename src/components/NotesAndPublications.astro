---
import type { Lang, Dictionary } from "../lib/i18n";
import { interpolate } from "../lib/i18n";
import { notes } from "../data/notes";
import publications from "../data/publications.json";
import SectionBlock from "./SectionBlock.astro";

type Props = {
  lang: Lang;
  dict: Dictionary;
  notesIndex: number;
  publicationsIndex: number;
};

const { dict, notesIndex, publicationsIndex } = Astro.props;
const items = publications as Array<{
  year: string;
  title: string;
  venue: string;
  href?: string;
}>;
const count = (n: number) =>
  n > 0 ? interpolate(dict.site.entries, { count: String(n) }) : undefined;
---
<SectionBlock
  id="notes"
  index={notesIndex}
  title={dict.notes.title}
  description={dict.notes.description}
  count={count(notes.length)}
>
  <div class="notes-grid">
    {notes.map((note) => (
      <a class="note-card" href={note.href} target="_blank" rel="noopener noreferrer">
        <h3>{dict.notes[note.titleKey]}</h3>
        <p>{dict.notes[note.descriptionKey]}</p>
        <span>{dict.notes.openNotion}</span>
      </a>
    ))}
  </div>
</SectionBlock>

<SectionBlock
  id="publications"
  index={publicationsIndex}
  title={dict.publications.title}
  description={dict.publications.description}
  count={count(items.length)}
>
  <ol class="publication-list">
    {items.length === 0 && <li class="empty-state">{dict.publications.empty}</li>}
    {items.map((item) => (
      <li>
        <span>
          {item.year}. {item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}. {item.venue}.
        </span>
      </li>
    ))}
  </ol>
</SectionBlock>
