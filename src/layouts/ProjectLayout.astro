---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchNav from "../components/ResearchNav.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import { getDict, htmlLang, researchHomeHref, type Lang } from "../lib/i18n";
import { coverUrl, getProject, renderProjectBody } from "../lib/projects";
import "../styles/research.css";

type Props = {
  lang: Lang;
  slug: string;
};

const { lang, slug } = Astro.props;
const dict = getDict(lang);
const project = getProject(slug);
const rendered = project ? await renderProjectBody(slug, lang) : null;
const Content = rendered?.Content;
const backHref = researchHomeHref(lang, "#projects");
const links = Object.entries(project?.links ?? {}).filter(
  (entry): entry is [string, string] =>
    typeof entry[1] === "string" && entry[1].trim().length > 0
);
const linkLabels: Record<string, string> = {
  github: "GitHub",
  website: "Website",
  arxiv: "arXiv",
  publication: "Publication",
};
---
<BaseLayout
  title={project ? `${project.title} | XDzZyq Research` : `${dict.detail.notFoundTitle} | XDzZyq Research`}
  lang={htmlLang(lang)}
  bodyClass="research-page"
  description={project?.summary ?? dict.detail.notFoundMessage}
>
  <script src="../scripts/lang-redirect.ts"></script>
  <main class="research-main">
    <div class="research-shell">
      <ResearchNav lang={lang} dict={dict} variant="detail" />
      <div class="project-root">
        {!project && (
          <section class="detail-panel">
            <h1>{dict.detail.notFoundTitle}</h1>
            <p>{dict.detail.notFoundMessage}</p>
            <a class="link-button link-button--primary back-link-bottom" href={backHref}>{dict.detail.backButton}</a>
          </section>
        )}
        {project && (
          <>
            <a class="back-link" href={backHref}>{dict.detail.backToList}</a>
            <section class="detail-hero">
              <p class="detail-meta">
                <span>{project.year}</span>
                <span class="entry__sep" aria-hidden="true">/</span>
                <span>{project.status}</span>
              </p>
              <h2>{project.title}</h2>
              <p class="research-hero__intro">{project.summary}</p>
              {project.affiliation && (
                <p class="detail-affiliation">{dict.detail.affiliationPrefix} / {project.affiliation}</p>
              )}
              {project.piWebsite && (
                <p class="detail-pi">
                  <a class="detail-pi-link" href={project.piWebsite} target="_blank" rel="noopener noreferrer">{dict.detail.piLab} ↗</a>
                </p>
              )}
              {project.tags?.length > 0 && (
                <ul class="tag-list detail-tags">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
              <img class="detail-cover" src={coverUrl(project.coverImage)} alt={project.coverAlt || `${project.title} cover image`} />
            </section>
            {project.abstract && (
              <section class="detail-panel">
                <h3>{dict.detail.abstract}</h3>
                <p>{project.abstract}</p>
              </section>
            )}
            <section class="detail-panel markdown-panel">
              {Content ? (
                <div class="markdown-body">
                  <Content />
                </div>
              ) : (
                <p class="empty-state">{dict.detail.markdownMissing}</p>
              )}
            </section>
            <section class="detail-panel">
              <h3>{dict.detail.links}</h3>
              <div class="button-row">
                {links.map(([type, href]) => (
                  <a class="link-button" href={href} target="_blank" rel="noopener noreferrer">
                    {linkLabels[type] || type} ↗
                  </a>
                ))}
                {links.length === 0 && <p class="empty-state">{dict.detail.noLinks}</p>}
              </div>
            </section>
            <a class="link-button link-button--primary back-link-bottom" href={backHref}>{dict.detail.backButton}</a>
          </>
        )}
      </div>
    </div>
  </main>
  <footer class="site-footer">
    <p>{dict.footer.copyright}</p>
  </footer>
  <SearchOverlay lang={lang} dict={dict} />
</BaseLayout>
