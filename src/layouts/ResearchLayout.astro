---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchNav from "../components/ResearchNav.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import ProjectList from "../components/ProjectList.astro";
import NotesAndPublications from "../components/NotesAndPublications.astro";
import SectionBlock from "../components/SectionBlock.astro";
import { getDict, htmlLang, interpolate, type Lang } from "../lib/i18n";
import { getProjectsByCategory } from "../lib/projects";
import "../styles/research.css";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const dict = getDict(lang);
const email = "xdz.zhang@mail.utoronto.ca";
const cv = "/res/CV - Yuqian Zhang.pdf";
const github = "https://github.com/XDzzzzzZyq";
const count = (n: number) => interpolate(dict.site.entries, { count: String(n) });
const researchCount = getProjectsByCategory("research").length;
const personalCount = getProjectsByCategory("personal").length;
---
<BaseLayout
  title={`${dict.site.title} | XDzZyq`}
  lang={htmlLang(lang)}
  bodyClass="research-page"
  description={dict.hero.intro}
>
  <script src="../scripts/lang-redirect.ts"></script>
  <div class="bg-layer" aria-hidden="true">
    <div class="bg-layer__mark"></div>
  </div>
  <main class="research-main">
    <div class="research-shell">
      <ResearchNav lang={lang} dict={dict} />

      <section class="hero" id="home" aria-labelledby="research-title">
        <p class="hero__eyebrow label">{dict.site.brand} / {dict.site.title}</p>
        <div class="hero__mark" aria-hidden="true"></div>
        <h1 id="research-title">{dict.hero.title}</h1>
        <p class="hero__intro">{dict.hero.intro}</p>
        <dl class="spec-strip">
          <div class="spec">
            <dt>{dict.snapshot.name}</dt>
            <dd>{dict.snapshot.nameValue}</dd>
          </div>
          <div class="spec">
            <dt>{dict.snapshot.status}</dt>
            <dd>{dict.snapshot.statusValue}</dd>
          </div>
          <div class="spec">
            <dt>{dict.snapshot.focus}</dt>
            <dd>{dict.snapshot.focusValue}</dd>
          </div>
          <div class="spec">
            <dt>{dict.snapshot.contact}</dt>
            <dd><a href={`mailto:${email}`}>{email}</a></dd>
          </div>
        </dl>
        <div class="button-row">
          <a class="link-button link-button--primary" href={cv} target="_blank" rel="noopener noreferrer" download>{dict.snapshot.downloadCV}</a>
          <a class="link-button" href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </section>

      <SectionBlock id="bio" index={1} title={dict.bio.title} description={dict.bio.description}>
        <div class="bio">
          <div class="bio__prose">
            <p>{dict.bio.paragraph1}</p>
            <p>{dict.bio.paragraph2}</p>
          </div>
          <dl class="facts">
            <div class="fact">
              <dt>{dict.bio.now}</dt>
              <dd>{dict.bio.nowValue}</dd>
            </div>
            <div class="fact">
              <dt>{dict.bio.bachelor}</dt>
              <dd>{dict.bio.bachelorValue}</dd>
            </div>
            <div class="fact">
              <dt>{dict.snapshot.contact}</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
          </dl>
        </div>
      </SectionBlock>

      <SectionBlock
        id="projects"
        index={2}
        title={dict.projects.title}
        descriptionHtml={dict.projects.description}
        count={count(researchCount)}
      >
        <ProjectList lang={lang} dict={dict} category="research" />
      </SectionBlock>

      <SectionBlock
        id="personal-projects"
        index={3}
        title={dict.personalProjects.title}
        description={dict.personalProjects.description}
        count={count(personalCount)}
      >
        <ProjectList lang={lang} dict={dict} category="personal" />
      </SectionBlock>

      <NotesAndPublications lang={lang} dict={dict} notesIndex={4} publicationsIndex={5} />

      <SectionBlock id="contact" index={6} title={dict.contact.title} description={dict.contact.description}>
        <div class="contact-strip">
          <a class="contact-strip__mail" href={`mailto:${email}`}>{email}</a>
          <div class="contact-links">
            <a class="link-button link-button--primary" href={cv} target="_blank" rel="noopener noreferrer" download>{dict.snapshot.downloadCV}</a>
            <a class="link-button" href={`mailto:${email}`}>{dict.contact.emailButton}</a>
            <a class="link-button" href={github} target="_blank" rel="noopener noreferrer">{dict.contact.githubButton}</a>
          </div>
        </div>
      </SectionBlock>
    </div>
  </main>
  <footer class="site-footer">
    <p>{dict.footer.copyright}</p>
  </footer>
  <SearchOverlay lang={lang} dict={dict} />
</BaseLayout>
